{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campusloop",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-25",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campusloop-db",
      "database_id": "51884ac1-9b6b-400e-92a9-48619041c13f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "campusloop-images"
    }
  ]
}
